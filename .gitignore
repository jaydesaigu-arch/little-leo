.venv/
__pycache__/
*.pyc

# Credentials — never committed, never logged.
.env
*.key
secrets.*

# Regenerable: the corpus is deterministic from a seed.
data/corpus.jsonl
data/*.log

# Weights belong on the Hub, not in git.
artifacts/*/model.pt
artifacts/*/onnx/*.onnx
artifacts/*/onnx/*.onnx.data

# Provider keys dropped in by hand.
Openrouter.txt
openrouter.txt
OPENROUTER*.txt
*_key.txt
*apikey*

# Local integrity snapshots. Sealed copies of publish/ used to prove the
# shipped weights never changed; five ~86MB duplicates of the same ONNX.
# Verified with scripts/package_release.py --check, not distributed.
safeguard/
